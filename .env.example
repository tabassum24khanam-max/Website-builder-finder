# =========================================
#  LeadHunter AI — Configuration
# =========================================
#  1. Copy this file -> rename to ".env"
#  2. Fill in your keys below
#  3. Run: npm install && npm start
#
#  See HANDOFF.md for the full explanation of every variable, what's
#  required vs optional, and how the tier/billing/owner system uses them.
# =========================================

# ---- Core / required ----------------------------------------------------

# Signs login session cookies. MUST be a real random value in production —
# if unset, the app falls back to an insecure hardcoded default and logs a
# warning on boot. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The email address that gets Owner access (unlimited quota + the Owner
# Dashboard) the moment it logs in or signs up. No separate flag to set —
# this env var IS the check.
OWNER_EMAIL=

# Where the SQLite database file lives. The Dockerfile already defaults this
# to /data for Railway deploys — you only need to set it locally if you want
# data to persist outside the repo folder. On Railway, what actually matters
# is that a persistent VOLUME is mounted at this path (Railway dashboard ->
# your service -> Volumes tab) — the env var alone does nothing without it.
DATA_DIR=.

# App port (Railway sets this automatically; default 3000 locally).
PORT=3000

# Set to "production" on Railway — controls whether session cookies are
# marked `secure` (requires HTTPS, which Railway provides).
NODE_ENV=development

# ---- Discovery / enrichment ----------------------------------------------

# RECOMMENDED — Serper.dev key. Powers business discovery (Google Maps),
# plus finding websites, phones, Instagram and LinkedIn.
# Free tier = 2,500 searches. Get one at https://serper.dev
SERPER_API_KEY=

# Optional: additional Serper accounts for automatic failover when one runs
# out of credit or its key becomes invalid. Exact naming matters — first key
# has NO number, then _2, _3, etc. Add as many as you have accounts.
# Check which one is currently active anytime via the Owner Dashboard.
SERPER_API_KEY_2=
SERPER_API_KEY_3=

# RECOMMENDED (best quality): Google Places API key. When set, it becomes
# the PRIMARY discovery source — every business comes back with the exact
# phone number + website that Google Maps shows (Serper cannot return
# those). Enable "Places API (New)" in Google Cloud. Free $200/month credit
# covers ~1,000+ searches. Leave blank to run on Serper/OpenStreetMap only.
GOOGLE_PLACES_API_KEY=

# Optional: Google Maps JavaScript API key. With it, the search-form map
# gains real click-to-drop-pin. Without it, the map still works (keyless
# Google embed, movable, location set by typing). Browser key — create in
# Google Cloud -> Credentials, enable "Maps JavaScript API" + "Geocoding
# API", and restrict by HTTP referrer (e.g. *.up.railway.app/*).
GOOGLE_MAPS_API_KEY=

# Optional: Hunter.io key for extra email finding (free: 25/month).
HUNTER_API_KEY=

# Delay between businesses in ms during a search (gentle pacing; default 300).
SCRAPE_DELAY_MS=300

# ---- AI provider (powers AI Deep Research + lead scoring) ----------------

# Option A (cheapest, preferred automatically when set): DeepSeek —
# https://platform.deepseek.com -> API Keys.
DEEPSEEK_API_KEY=

# Option B: OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: OpenAI model for normal enrichment (default: gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Optional: model for "AI Deep Research" mode (default: gpt-4o — a frontier
# model for human-level judgment: deciding which number truly belongs to the
# business, rejecting wrong-region numbers, confirming the right Instagram).
AI_MODE_MODEL=gpt-4o

# ---- Email (contact form + low-Serper-key alerts) ------------------------

# Gmail App Password (NOT your regular Gmail password — generate one at
# myaccount.google.com/apppasswords) for the account the app sends mail
# from. Without this, contact form messages and low-Serper-key alerts still
# save to the database (visible in the Owner Dashboard) but no email sends.
GMAIL_APP_PASSWORD=

# ---- PayPal Subscriptions (billing) --------------------------------------
# See HANDOFF.md section 6 ("PayPal: sandbox vs. live") before touching these.

# From developer.paypal.com -> Apps & Credentials. Sandbox and Live have
# SEPARATE credentials — make sure these and the Plan/Webhook IDs below all
# belong to the same mode (sandbox or live), never mixed.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# "live" for real money. Anything else (or unset) = sandbox (safe default —
# a missing/unset mode can never accidentally charge a real card).
PAYPAL_MODE=

# Generated via the Owner Dashboard's "Generate Product + Plans + Webhook"
# button (or scripts/paypal-setup.js) — do not invent these by hand.
PAYPAL_PLAN_ID_STARTER=
PAYPAL_PLAN_ID_PRO=
PAYPAL_WEBHOOK_ID=

# The real public URL of the deployed app (e.g. https://your-app.up.railway.app)
# — required so the PayPal webhook has somewhere to call back to.
APP_BASE_URL=
